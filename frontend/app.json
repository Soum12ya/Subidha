{
  "expo": {
    "name": "SUBIDHA",
    "slug": "subidha",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "subidha",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android", "web"],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/Subidha"
    }
  }
}